# Copy to .env for local development. Never commit a real key.
TENDER_SECRET_KEY=
# Defaults to this project's data/ directory regardless of working directory.
# TENDER_DATA_DIR=/absolute/path/to/project/data
TENDER_LIVE_MODEL_CALLS=false
# Leave blank to discover soffice/libreoffice on PATH.
TENDER_LIBREOFFICE_PATH=
TENDER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TENDER_HTTP_PORT=8088
TENDER_AUTO_CREATE_SCHEMA=true
